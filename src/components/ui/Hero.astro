---
import type { ImageMetadata } from 'astro'

import SocialIcons from './SocialIcons.astro'


interface Props {
  fullName: string
  title: string
  institute?: string
  profilePicture: ImageMetadata
  description?: string
}

const {fullName, title, institute, description} = Astro.props
---
<div class='flex-1'>
  <h1 class='text-4xl font-bold mb-4'>
    Welcome! I'm <span class='text-secondary'>{fullName}</span>
  </h1>
  <p class='text-xl text-gray-600 mb-4'>{title}{institute ? ` at ${institute}` : ''}</p>
  <p class='text-lg mb-6'>
    {description ?? 'Brief impactful description of your research focus and academic mission. Highlight your key contributions and areas of expertise.'}
  </p>
  <div class='flex gap-4'>
    <SocialIcons />
  </div>
</div>
